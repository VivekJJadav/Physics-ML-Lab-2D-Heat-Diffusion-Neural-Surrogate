# Experiment data and simulation outputs
# Exclude large binary simulation datasets (regenerate with experiments/generate_onestep_dataset.py)
outputs/datasets/**/*.npz

# Exclude intermediate / scratch figures (keep publication figures tracked for documentation)
outputs/figures/*.png
!outputs/figures/publication/
!outputs/figures/publication/*.png

# Model checkpoints (680 KB each; can be committed or released via GitHub Releases)
# Uncomment to exclude binary weights from git tracking:
# outputs/models/*.pt
